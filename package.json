{
  "name": "capim",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "description": "Capim — organização de finanças pessoais com chat e agente (offline-first)",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "smoke": "npx tsx scripts/smoke-domain.ts",
    "cid:check": "CID_PROJECT_NAME='Capim' CID_SCAN_ROOTS=src,app,server,shared,scripts node scripts/cid-check.mjs",
    "db:check": "node scripts/db-check.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "expo": "~54.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.8",
    "expo-crypto": "~15.0.6",
    "expo-font": "~14.0.7",
    "expo-linking": "~8.0.7",
    "expo-local-authentication": "~17.0.8",
    "expo-router": "~6.0.1",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.7",
    "expo-status-bar": "~3.0.7",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "react-refresh": "^0.18.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~54.0.0",
    "typescript": "~5.9.2"
  }
}
